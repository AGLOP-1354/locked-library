{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm exec next:*)",
      "Read(node_modules/next/dist/docs/**)"
    ],
    "deny": [
      "Read(.env.local)",
      "Read(.env.*.local)"
    ]
  }
}
